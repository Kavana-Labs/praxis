# Praxis web editor — copy to .env.local for local development.
# All VITE_* values are exposed to the browser by design; never put secrets here.

# Execution service (Python sandbox). Defaults to http://localhost:8000.
VITE_EXECUTOR_URL=

# Google Slides import (optional). Created in Google Cloud Console:
#  - OAuth 2.0 Web client id (authorized JavaScript origins: your dev/prod URLs)
#  - API key with the Google Picker API enabled (Drive API enabled on the project)
#  - Project number, optional (tightens drive.file scoping in the Picker)
# The token flow uses no client secret anywhere. See docs/presentation-import.md.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
