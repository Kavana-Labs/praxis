# --------------------
# Global
# --------------------
NODE_ENV=development

# --------------------
# Platform API (NestJS)
# --------------------
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/praxis
REDIS_URL=redis://localhost:6379

# --------------------
# Execution Service
# --------------------
EXECUTOR_PORT=8000
EXECUTOR_REDIS_URL=redis://redis:6379
EXECUTOR_TIMEOUT_SECONDS=10
EXECUTOR_MAX_MEMORY_MB=512

# --------------------
# Web editor (Vite — set these in apps/web/.env.local; safe to expose)
# --------------------
# Execution service URL the editor talks to (default http://localhost:8000)
VITE_EXECUTOR_URL=
# Google Slides import (Picker + Drive export). Public-by-design values;
# no client secret is used (token flow). See docs/presentation-import.md.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=

# --------------------
# Object Storage (later)
# --------------------
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
